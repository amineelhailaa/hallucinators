{
  "name": "hallucinators",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run validate:content && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "record": "node --import tsx scripts/record.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "benchmark": "node scripts/lighthouse.mjs",
    "generate:content": "python3 scripts/content.py && python3 scripts/enrich-content.py && python3 scripts/search.py",
    "format": "prettier --write src scripts tests e2e *.ts *.json *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "i18next": "25.10.10",
    "katex": "0.19.0",
    "minisearch": "7.2.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "15.7.4",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
